package components

import "github.com/AzmainMahtab/chonkboard/web/view"

// CardForm creates or edits a card.
//
// A real form with a real action, so it submits with no JavaScript. When htmx is
// present the response replaces the lane it belongs to, which is why the action
// posts to the lane rather than to the board.
templ CardForm(projectSlug string, f view.CardForm) {
	@Modal(cardFormTitle(f)) {
		@ModalHeader(cardFormTitle(f))
		<form
			method="post"
			action={ cardFormAction(projectSlug, f) }
			class="flex flex-col gap-4 px-4 py-4"
		>
			<input type="hidden" name="csrf_token" value={ formCSRF(ctx) }/>
			if f.Error != "" {
				<div role="alert" class="rounded-card border border-danger/35 bg-danger/10 px-3 py-2 text-sm">
					{ f.Error }
				</div>
			}
			if f.IsNew() && f.LaneName != "" {
				<p class="text-xs text-ink-3">Adding to <strong class="font-medium text-ink-2">{ f.LaneName }</strong></p>
			}
			<div>
				<label for="card-title" class="form-label">Title</label>
				<input
					id="card-title"
					name="title"
					type="text"
					class="field"
					value={ f.Title }
					maxlength="200"
					required
					autofocus
					{ fieldState("card-title", f.TitleError)... }
				/>
				if f.TitleError != "" {
					<p id="card-title-error" class="mt-1 text-xs text-danger">{ f.TitleError }</p>
				}
			</div>
			<div>
				<label for="card-description" class="form-label">
					Description <span class="font-normal text-ink-3">optional, markdown</span>
				</label>
				<textarea
					id="card-description"
					name="description"
					class="field min-h-28 resize-y font-mono text-xs"
					maxlength="20000"
					{ fieldState("card-description", f.DescError)... }
				>{ f.Description }</textarea>
				if f.DescError != "" {
					<p id="card-description-error" class="mt-1 text-xs text-danger">{ f.DescError }</p>
				}
			</div>
			<div class="grid gap-4 sm:grid-cols-2">
				<div>
					<label for="card-priority" class="form-label">Priority</label>
					<select id="card-priority" name="priority" class="field">
						for _, p := range f.Priorities {
							<option value={ p.Value } selected?={ p.Value == f.Priority }>{ p.Label }</option>
						}
					</select>
				</div>
				<div>
					<label for="card-due" class="form-label">
						Due <span class="font-normal text-ink-3">optional</span>
					</label>
					<input
						id="card-due"
						name="due_at"
						type="date"
						class="field"
						value={ f.DueAt }
						{ fieldState("card-due", f.DueError)... }
					/>
					if f.DueError != "" {
						<p id="card-due-error" class="mt-1 text-xs text-danger">{ f.DueError }</p>
					}
				</div>
			</div>
			<div>
				<label for="card-assignee" class="form-label">
					Assignee <span class="font-normal text-ink-3">optional</span>
				</label>
				<select
					id="card-assignee"
					name="assignee"
					class="field"
					{ fieldState("card-assignee", f.AssigneeError)... }
				>
					<option value="">Nobody</option>
					for _, person := range f.People {
						<option value={ person.UUID } selected?={ person.UUID == f.Assignee }>
							{ person.DisplayName }
						</option>
					}
				</select>
				if f.AssigneeError != "" {
					<p id="card-assignee-error" class="mt-1 text-xs text-danger">{ f.AssigneeError }</p>
				}
			</div>
			if len(f.Labels) > 0 {
				<fieldset>
					<legend class="form-label">Labels</legend>
					<div class="flex flex-wrap gap-1.5">
						for _, l := range f.Labels {
							@labelCheckbox(l, f.HasLabel(l.UUID))
						}
					</div>
				</fieldset>
			}
			<div class="flex items-center gap-2">
				<button type="submit" class="btn-primary">
					if f.IsNew() {
						Add card
					} else {
						Save card
					}
				</button>
				<button
					type="button"
					class="btn-quiet"
					@click="open = false; $nextTick(() => $root.remove())"
				>Cancel</button>
			</div>
		</form>
	}
}

// labelCheckbox is one label, drawn as its own chip.
//
// A real checkbox, visually hidden rather than replaced, so it is keyboard reachable
// and announced as a checkbox.
templ labelCheckbox(l view.Label, ticked bool) {
	<label class="cursor-pointer">
		<input
			type="checkbox"
			name="labels"
			value={ l.UUID }
			class="peer sr-only"
			checked?={ ticked }
		/>
		<span
			class={
				"block rounded-pill px-2 py-0.5 text-2xs font-medium ring-offset-2 ring-offset-surface",
				"opacity-45 peer-checked:opacity-100",
				"peer-focus-visible:ring-2 peer-focus-visible:ring-accent peer-checked:ring-1 peer-checked:ring-ink/20",
				labelTint(l.Color),
			}
		>{ l.Name }</span>
	</label>
}
