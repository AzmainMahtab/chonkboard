package components

import "github.com/AzmainMahtab/chonkboard/web/view"

// LabelRow is one project label on the settings page.
templ LabelRow(projectSlug string, l view.Label) {
	<li class="flex items-center gap-3 rounded-card border border-line bg-surface px-3 py-2">
		@LabelChip(l)
		<span class="flex-1"></span>
		<a
			href={ templ.SafeURL("/projects/" + projectSlug + "/labels/" + l.UUID + "/edit") }
			class="btn-quiet px-2 text-xs"
		>Edit</a>
		<form
			method="post"
			action={ templ.SafeURL("/projects/" + projectSlug + "/labels/" + l.UUID + "/delete") }
			onsubmit="return confirm('Delete this label? It is removed from every card that carries it.')"
		>
			<input type="hidden" name="csrf_token" value={ formCSRF(ctx) }/>
			<button
				type="submit"
				class="btn-quiet px-2 text-xs text-danger hover:bg-danger/10"
			>Delete</button>
		</form>
	</li>
}

// LabelForm creates or renames a project label.
templ LabelForm(projectSlug string, f view.LabelForm) {
	<form
		method="post"
		action={ labelFormAction(projectSlug, f) }
		class="mt-3 flex flex-wrap items-end gap-2"
	>
		<input type="hidden" name="csrf_token" value={ formCSRF(ctx) }/>
		if f.Error != "" {
			<div role="alert" class="w-full rounded-card border border-danger/35 bg-danger/10 px-3 py-2 text-sm">
				{ f.Error }
			</div>
		}
		<div class="min-w-40 flex-1">
			<label for="label-name" class="form-label">
				if f.IsNew() {
					New label
				} else {
					Label name
				}
			</label>
			<input
				id="label-name"
				name="name"
				type="text"
				class="field"
				value={ f.Name }
				maxlength="40"
				required
				{ fieldState("label-name", f.NameError)... }
			/>
			if f.NameError != "" {
				<p id="label-name-error" class="mt-1 text-xs text-danger">{ f.NameError }</p>
			}
		</div>
		<fieldset>
			<legend class="form-label">Colour</legend>
			<div class="flex flex-wrap gap-1.5">
				for _, colour := range f.Colours {
					@colourSwatch(colour, colour == f.Colour)
				}
			</div>
		</fieldset>
		<button type="submit" class="btn-primary">
			if f.IsNew() {
				Add label
			} else {
				Save label
			}
		</button>
		if !f.IsNew() {
			<a href={ settingsURL(projectSlug) } class="btn-quiet">Cancel</a>
		}
	</form>
}
