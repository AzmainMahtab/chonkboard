package components

// Modal is the shell every fragment swapped into #modal uses.
//
// The backdrop closes it, Escape closes it, and focus is trapped inside while it is
// open — none of which a `<div>` gets for free. `x-trap.noscroll` is Alpine's focus
// trap: it moves focus in on open, cycles Tab within the panel, and restores focus
// to whatever had it when the modal closes.
//
// Closing empties #modal rather than hiding it, so a stale card does not linger in
// the DOM to be found by a subsequent out-of-band swap.
templ Modal(title string) {
	<div
		x-data="{ open: true }"
		x-show="open"
		x-trap.noscroll="open"
		@keydown.escape.window="open = false; $nextTick(() => $el.remove())"
		class="fixed inset-0 z-40 flex items-start justify-center overflow-y-auto p-4 sm:p-8"
		role="dialog"
		aria-modal="true"
		aria-label={ title }
	>
		<div
			class="fixed inset-0 bg-ink/35"
			@click="open = false; $nextTick(() => $el.parentElement.remove())"
			aria-hidden="true"
		></div>
		<div class="relative w-full max-w-lg rounded-lane border border-line bg-surface shadow-pop">
			{ children... }
		</div>
	</div>
}

// ModalHeader is the title row, with the close button every modal needs.
templ ModalHeader(title string) {
	<header class="flex items-start gap-3 border-b border-line px-4 py-3">
		<h2 class="flex-1 text-sm font-semibold tracking-tight">{ title }</h2>
		<button
			type="button"
			class="rounded-card px-1.5 text-ink-3 hover:bg-surface-2 hover:text-ink"
			@click="open = false; $nextTick(() => $root.remove())"
			aria-label="Close"
		>&times;</button>
	</header>
}
