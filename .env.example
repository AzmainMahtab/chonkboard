# Copy to .env. Make and docker compose read this file; the Go binary reads the
# environment, so the two never disagree about a value.

# local | production. Controls log format and cookie Secure.
APP_ENV=local
APP_ADDR=:8080
# host port docker compose publishes
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
# debug | info | warn | error
LOG_LEVEL=info

# SQLite. One file holds everything; back it up and you have backed up the app.
DB_PATH=./data/chonkboard.db

# Read-pool size. 0 means one connection per CPU. The writer pool is always
# pinned to 1, because SQLite allows exactly one writer at a time.
DB_MAX_READERS=0

# Recycle pooled connections after this long. 0 means never.
DB_CONN_MAX_LIFETIME=0s

# Sessions. Go durations have no day unit: 7 days is 168h.
SESSION_TTL=168h
# must be true anywhere served over https
SESSION_COOKIE_SECURE=false

# The first super admin, created on first boot only. Leave the password unset and
# one is generated and printed once to stdout.
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=

# Card attachments.
UPLOAD_DIR=./data/uploads
# 10 MiB per file
UPLOAD_MAX_BYTES=10485760

# Backups: VACUUM INTO snapshots, oldest pruned past BACKUP_KEEP.
BACKUP_DIR=./data/backups
BACKUP_INTERVAL=6h
BACKUP_KEEP=28

# No inline comments in this file. Make's `-include` strips a `#` comment from a line but
# leaves the whitespace in front of it, so `KEY=value   # note` becomes "value   " and
# fails to parse; `docker --env-file` keeps the comment as part of the value outright.
# Comments go on their own line, above what they describe.
